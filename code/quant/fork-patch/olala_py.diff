+    def _finalize_quantized_params(
+        self, routed_by_layer: dict[int, RoutedExperts], loaded: set[str]
+    ) -> None:
+        """Fill what a weight-only checkpoint cannot carry, then check coverage.
+
+        The default loader's completeness check is off for quantized models
+        (default_loader.py:510-516) and the old ``warning_once`` hid missing
+        tensors, so every parameter of a quantized Linear or RoutedExperts
+        must be reported loaded here.
+        """
+        for layer_idx, routed in routed_by_layer.items():
+            # CompressedTensorsW4A4Nvfp4MoEMethod creates input global scales even
+            # for NVFP4A16 and reads them unconditionally in
+            # process_weights_after_loading; give them the neutral value 1.0
+            # rather than leaving torch.empty garbage.
+            if getattr(routed.quant_method, "use_a16", False):
+                for pname in olq.UNUSED_A16_PARAMS:
+                    p = getattr(routed, pname, None)
+                    if p is not None:
+                        p.data.fill_(1.0)
+                        loaded.add(f"model.layers.{layer_idx}.mlp.experts.{pname}")
+        expected: list[str] = []
+        for mod_name, module in self.named_modules():
+            if not isinstance(module, LinearBase):
+                continue
+            qm = getattr(module, "quant_method", None)
+            if qm is None or isinstance(qm, UnquantizedLinearMethod):
+                continue
+            if getattr(qm, "uses_meta_device", False):
+                continue  # online quantization: parameters are built after loading
+            expected.extend(
+                f"{mod_name}.{pname}" if mod_name else pname
+                for pname, _ in module.named_parameters(recurse=False)
+            )
+        for layer_idx, routed in routed_by_layer.items():
+            qm = routed.quant_method
+            if isinstance(qm, UnquantizedFusedMoEMethod) or getattr(
+                qm, "uses_meta_device", False
+            ):
+                continue
+            # Only the weight parameters the quantization method created (w13_*,
+            # w2_*); RoutedExperts also exposes the gate's e_score_correction_bias.
+            expected.extend(
+                f"model.layers.{layer_idx}.mlp.experts.{pname}"
+                for pname, _ in routed.named_parameters(recurse=False)
+                if pname.startswith(("w13_", "w2_"))
+            )
+        missing = olq.unloaded_params(expected, loaded)
+        if missing:
+            raise olq.OlalaQuantLoadError(
+                f"Olala load_weights: {len(missing)} parameter(s) of quantized modules "
+                "received no checkpoint tensor (they would stay uninitialized): "
+                + ", ".join(missing)
+            )
 
