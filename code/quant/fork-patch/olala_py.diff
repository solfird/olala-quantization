+    def _load_one_weight(
+        self,
+        name: str,
+        loaded_weight: torch.Tensor,
+        route: "olq.Route",
+        routed_by_layer: dict[int, RoutedExperts],
+        params_dict: dict[str, nn.Parameter],
+        buffers_dict: dict[str, torch.Tensor],
+        loaded: set[str],
+        tracker: "olq.LoadTracker",
+    ) -> None:
+        """Load one checkpoint tensor according to its route (see olala_quant_loader)."""
+        if route.kind == "drop":
+            tracker.consume(name)  # non-persistent buffer
+        elif route.kind == "unsupported_fused":
+            tracker.reject(name, "unsupported suffix for a fused routed-expert tensor")
+        elif route.kind == "fused_experts":
+            assert route.layer is not None and route.fused_param is not None
+            routed = routed_by_layer[route.layer]
+            param = getattr(routed, route.fused_param, None)
+            if param is None and route.legacy_param is not None:
+                legacy = getattr(routed, route.legacy_param, None)
+                if legacy is not None:
+                    # Serialized experts_int8 checkpoint: the per-row scales of
+                    # every expert of the layer (single rank). Unchanged behaviour.
+                    if legacy.shape != loaded_weight.shape:
+                        raise olq.OlalaQuantLoadError(
+                            f"Olala load_weights: {name} has shape "
+                            f"{tuple(loaded_weight.shape)}, expected "
+                            f"{tuple(legacy.shape)}."
+                        )
+                    legacy.data.copy_(loaded_weight)
+                    loaded.add(
+                        f"model.layers.{route.layer}.mlp.experts.{route.legacy_param}"
+                    )
+                    tracker.consume(name)
+                    return
+            if param is None:
+                tracker.reject(
+                    name,
+                    f"RoutedExperts of layer {route.layer} has no parameter "
+                    f"{route.fused_param} (quantization method "
+                    f"{type(routed.quant_method).__name__}); is the layer in "
+                    "quantization_config.ignore while the checkpoint stores it quantized?",
+                )
+                return
+            # Olala packs every expert into one tensor; scatter it into the
+            # fused w13/w2 parameters expert by expert. RoutedExperts.weight_loader
+            # dispatches on the NAME ("weight", "scale", ...), so loader_name carries
+            # the real parameter name. With expert parallelism the loader declines the
+            # experts of other ranks; at least one must land here.
+            olq.scatter_fused_expert_tensor(
+                param,
+                loaded_weight,
+                route,
+                num_experts=self.config.moe_num_routed_experts,
+                tp_size=get_tensor_model_parallel_world_size(),
+            )
+            loaded.add(f"model.layers.{route.layer}.mlp.experts.{route.fused_param}")
+            tracker.consume(name)
+        elif route.kind == "expert_bias":
+            assert route.target is not None
+            if route.target not in params_dict:
+                tracker.reject(name, f"no parameter {route.target}")
+                return
+            param = params_dict[route.target]
+            param.data.copy_(loaded_weight.to(param.dtype).to(param.device))
+            loaded.add(route.target)
+            tracker.consume(name)
+        else:  # "direct" or "rename"
+            target = route.target
+            assert target is not None
+            if target in params_dict:
+                param = params_dict[target]
+                # copy_ casts silently: refuse to cross the quantized-storage
+                # boundary (fp8/uint8/int8 vs bf16/fp32) without a scale.
+                olq.check_dtype_contract(name, loaded_weight.dtype, param.dtype)
+                weight_loader = getattr(param, "weight_loader", default_weight_loader)
+                try:
+                    weight_loader(param, loaded_weight)
+                except (AssertionError, ValueError, RuntimeError) as e:
+                    raise olq.OlalaQuantLoadError(
+                        f"Olala load_weights: cannot load {name} into {target} "
+                        f"(parameter {tuple(param.shape)} {param.dtype}, checkpoint "
+                        f"{tuple(loaded_weight.shape)} {loaded_weight.dtype}): {e}"
+                    ) from e
+                loaded.add(target)
+                tracker.consume(name)
+            elif target in buffers_dict:
+                buf = buffers_dict[target]
+                buf.data.copy_(loaded_weight.to(buf.dtype).to(buf.device))
+                loaded.add(target)
+                tracker.consume(name)
+            else:
+                tracker.reject(
+                    name, f"no parameter or buffer named {target} in the model"
+                )
